# Copy to .env.local and fill from the PowerSave Supabase project (Settings → API).
# Guest mode works without these; sign-in and sync require them.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the new publishable key; anon JWT still works as a fallback in code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
